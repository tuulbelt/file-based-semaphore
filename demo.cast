{"version":3,"term":{"cols":80,"rows":24,"type":"xterm-256color"},"timestamp":1767115133,"command":"bash /var/folders/jj/ftvsbr992rq6q1rh__57kynm0000gn/T/tmp.Jy1xShhsjA","title":"file-based-semaphore / sema - Tuulbelt","env":{"SHELL":"/bin/zsh"}}
[0.015, "o", "# File-Based Semaphore Demo\r\n"]
[1.008, "o", "\r\n# 1. Acquire a lock (non-blocking)\r\n"]
[0.517, "o", "$ sema try /tmp/demo.lock --tag demo\r\n"]
[1.043, "o", "Lock acquired: /tmp/demo.lock\r\n"]
[1.009, "o", "\r\n# 2. Check lock status\r\n"]
[0.509, "o", "$ sema status /tmp/demo.lock\r\n"]
[0.322, "o", "Lock status: LOCKED\r\n  Path: /tmp/demo.lock\r\n  PID: 3080\r\n  Timestamp: 1767115136\r\n  Tag: demo\r\n  Process running: no\r\n"]
[1.515, "o", "\r\n# 3. Check status with JSON output\r\n"]
[0.513, "o", "$ sema status /tmp/demo.lock --json\r\n"]
[0.327, "o", "{\"locked\":true,\"pid\":3080,\"timestamp\":1767115136,\"tag\":\"demo\"}\r\n"]
[1.510, "o", "\r\n# 4. Release the lock\r\n"]
[0.512, "o", "$ sema release /tmp/demo.lock\r\n"]
[0.329, "o", "Lock released: /tmp/demo.lock\r\n"]
[1.014, "o", "\r\n# 5. Verify lock is released\r\n"]
[0.514, "o", "$ sema status /tmp/demo.lock\r\n"]
[0.325, "o", "Lock status: FREE\r\n  Path: /tmp/demo.lock\r\n"]
[1.515, "o", "\r\n# 6. Demo stale lock recovery\r\n"]
[0.517, "o", "# Creating a stale lock (old timestamp, dead PID)...\r\n"]
[0.533, "o", "$ cat /tmp/demo.lock\r\n"]
[0.013, "o", "pid=99999\r\ntimestamp=1767107946\r\n"]
[1.012, "o", "\r\n# Acquiring stale lock (--stale 3600 = 1 hour threshold)\r\n"]
[0.514, "o", "$ sema try /tmp/demo.lock --stale 3600\r\n"]
[0.331, "o", "Lock acquired: /tmp/demo.lock\r\n"]
[1.519, "o", "\r\n# Done! File-based semaphore with the sema command.\r\n"]
[2.020, "x", "0"]
