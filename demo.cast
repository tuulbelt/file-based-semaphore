{"version": 2, "width": 80, "height": 24, "timestamp": 1767142512, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "File Based Semaphore / sema - Tuulbelt"}
[0.004302, "o", "# File-Based Semaphore Demo\r\n"]
[1.00646, "o", "\r\n# 1. Acquire a lock (non-blocking)\r\n"]
[1.508177, "o", "$ sema try /tmp/demo.lock --tag demo\r\n"]
[1.81311, "o", "Lock acquired: /tmp/demo.lock\r\n"]
[2.814786, "o", "\r\n# 2. Check lock status\r\n"]
[3.316323, "o", "$ sema status /tmp/demo.lock\r\n"]
[3.619044, "o", "Lock status: LOCKED\r\n  Path: /tmp/demo.lock\r\n  PID: 7120\r\n  Timestamp: 1767142513\r\n  Tag: demo\r\n  Process running: no\r\n"]
[5.120577, "o", "\r\n# 3. Check status with JSON output\r\n"]
[5.622267, "o", "$ sema status /tmp/demo.lock --json\r\n"]
[5.92498, "o", "{\"locked\":true,\"pid\":7120,\"timestamp\":1767142513,\"tag\":\"demo\"}\r\n"]
[7.426495, "o", "\r\n# 4. Release the lock\r\n"]
[7.928093, "o", "$ sema release /tmp/demo.lock\r\n"]
[8.230836, "o", "Lock released: /tmp/demo.lock\r\n"]
[9.232282, "o", "\r\n# 5. Verify lock is released\r\n"]
[9.733987, "o", "$ sema status /tmp/demo.lock\r\n"]
[10.036642, "o", "Lock status: FREE\r\n  Path: /tmp/demo.lock\r\n"]
[11.538158, "o", "\r\n# 6. Demo stale lock recovery\r\n"]
[12.039667, "o", "# Creating a stale lock (old timestamp, dead PID)...\r\n"]
[12.542679, "o", "$ cat /tmp/demo.lock\r\n"]
[12.543891, "o", "pid=99999\r\ntimestamp=1767135324\r\n"]
[13.545333, "o", "\r\n# Acquiring stale lock (--stale 3600 = 1 hour threshold)\r\n"]
[14.047084, "o", "$ sema try /tmp/demo.lock --stale 3600\r\n"]
[14.350437, "o", "Lock acquired: /tmp/demo.lock\r\n"]
[15.851983, "o", "\r\n# Done! File-based semaphore with the sema command.\r\n"]
